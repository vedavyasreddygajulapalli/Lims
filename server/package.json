{
  "name": "@lims/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bootstrap": "node --import tsx src/bootstrap.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/domain.test.ts test/reference.test.ts test/dashboard.test.ts test/operations.test.ts test/files.test.ts",
    "test:integration": "node --import tsx --test test/workflow.test.ts"
  },
  "dependencies": {
    "@lims/core": "*",
    "@supabase/storage-js": "^2.118.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.2.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
