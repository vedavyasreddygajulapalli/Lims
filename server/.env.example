MONGODB_URI=mongodb://127.0.0.1:27017/sainath_lims?replicaSet=rs0
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# One-time bootstrap only; do not commit these values
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Private client files: all values stay server-side. Use a private Supabase Free bucket.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=lims-private
# Base64 encoded 32-byte key. Back it up separately; losing it loses file access.
FILE_ENCRYPTION_KEY=
# ClamAV daemon on a trusted/private network. Uploads fail closed without it.
CLAMAV_HOST=
CLAMAV_PORT=3310
